<div class="row">
    <div class="col-md-6 col-12">
        <div class="card">
            <div class="card-content">
                <div class="card-body">
                    <form class="form form-vertical" method="post" data-parsley-validate
                          action="{% if category.id is defined %}{{ path('category_update', {'id':  category.id }) }}{% else %}{{ path('category_update', {'id':  0 }) }}{% endif %}"
                    >
                        <input type="hidden" name="action" id="action" value="{{ action }}">
                        <div class="form-body">
                            <div class="row">
                                <div class="col-12">
                                    <div class="form-group">
                                        <label for="name">Nombre</label>
                                        <div class="position-relative has-validation">
                                            <input type="text" class="form-control" id="name" name="name"
                                                   required
                                                   value="{% if category.name is defined %}{{ category.name }}{% endif %}">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-group ">
                                        <label for="slug">Slug</label>
                                        <div class="position-relative has-validation">
                                            <input type="text" class="form-control"
                                                   id="slug" name="slug" required
                                                   value="{% if category.slug is defined %}{{ category.slug }}{% endif %}">
                                            <div class="valid-feedback"></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 d-flex justify-content-end mt-3">
                                    <button type="submit" class="btn btn-primary me-1 mb-1">Guardar</button>
                                    <button type="reset" class="btn btn-light-secondary me-1 mb-1">Reiniciar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>