{% extends 'base.html.twig' %}

{% block title %}Editar producto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/product.scss') }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% block importmap %}{{ importmap(['app' , 'parsley', 'producto', 'sweetalert' ]) }}{% endblock %}
{% endblock %}

{% block content %}
    <h2 class="ps-3">Editar producto</h2>

    {{ include('product/_form.html.twig') }}

    <a class="btn btn-primary ms-3" href="{{ path('product_index') }}">Volver a la lista</a>

    {{ include('product/_delete_form.html.twig') }}
{% endblock %}
