{% extends 'auth.html.twig' %}

{% block title %}{{ title }} - {{ web_title }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% block importmap %}{{ importmap(['app', 'parsley' ]) }}{% endblock %}
{% endblock %}
{% block content %}
    <div class="row h-100">
        <div class="col-lg-5 col-12">
            <div id="auth-left">
                <div class="auth-logo">
                    <img src="{{ asset('build/images/logo/LogoNova1.jpg') }}" alt="Logo">
                </div>
                <h1 class="auth-title">Iniciar sesión</h1>
                <form method="post" class="form form-vertical" data-parsley-validate id="login-form">
                    {% if error %}
                        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                    {% endif %}
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endfor %}


                    <div class="form-group mb-3">
                        <div class="input-group">
                            <span class="input-group-text icon-left"><i class="bi bi-person"></i></span>
                            <input type="email" class="form-control form-control-xl" placeholder="Usuario" value="{{ last_username }}" name="email" id="inputEmail" data-parsley-required="true"
                                   autofocus>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <div class="input-group ">
                            <span class="input-group-text icon-left"><i class="bi bi-shield-lock"></i></span>
                            <input type="password" class="form-control has-icon-right form-control-xl" placeholder="Contraseña" name="password" id="inputPassword" autocomplete="current-password"
                                   data-parsley-required="true">
                            <span class="input-group-text icon-right"><i class="bi bi-eye"></i></span>
                        </div>
                    </div>


                    <button class="btn btn-primary btn-block btn-lg shadow-lg mt-4">Iniciar sesión</button>
                    {# <h1 class="h3 mb-3 font-weight-normal">Please sign in</h1>
                    <label for="inputEmail">Email</label>
                    <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control"
                           autocomplete="email" required autofocus>
                    <label for="inputPassword">Password</label>
                    <input type="password" name="password" id="inputPassword" class="form-control"
                           autocomplete="current-password" required> #}

                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('authenticate') }}"
                    >

                    {#
                    Uncomment this section and add a remember_me option below your firewall to activate remember me functionality.
                    See https://symfony.com/doc/current/security/remember_me.html

                    <div class="checkbox mb-3">
                        <label>
                            <input type="checkbox" name="_remember_me"> Remember me
                        </label>
                    </div>
                    #}

                    {# <button class="btn btn-lg btn-primary" type="submit">
                        Sign in
                    </button> #}
                </form>
                <div class="text-center mt-4 text-lg fs-4">
                    <p><a class="font-bold" href="{{ path('app_forgot_password') }}">Contraseña olvidada?</a></p>
                </div>
            </div>
        </div>
        <div class="col-lg-7 d-none d-lg-block">
            <div id="auth-right">

            </div>
        </div>
    </div>

{% endblock %}
