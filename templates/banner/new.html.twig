{% extends 'base.html.twig' %}

{% block title %}Adicionar banner{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/banner.scss') }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% block importmap %}{{ importmap(['app' , 'parsley', 'banner' ]) }}{% endblock %}
{% endblock %}

{% block content %}
    <h2 class="ps-3">Adicionar banner</h2>

    {{ include('banner/_form.html.twig') }}

    <a class="btn btn-primary ms-3"  href="{{ path('banner_index') }}">Volver a la lista</a>
{% endblock %}
