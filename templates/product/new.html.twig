{% extends 'base.html.twig' %}

{% block title %}Adicionar producto{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/pages/product.scss') }}">
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    {% block importmap %}{{ importmap(['app' , 'parsley', 'producto' ]) }}{% endblock %}
{% endblock %}

{% block content %}
    <h2 class="ps-3">Adicionar producto</h2>

    {{ include('product/_form.html.twig') }}

    <a class="btn btn-primary ms-3"  href="{{ path('product_index') }}">Volver a la lista</a>
{% endblock %}
